{
  "cleanUrls": true,
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": false },
    { "source": "/app/(.*)", "destination": "/", "permanent": false },
    { "source": "/marketplace", "destination": "/", "permanent": false },
    { "source": "/marketplace/(.*)", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" }
  ]
}
